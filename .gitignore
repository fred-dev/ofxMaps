# A .gitignore for openFrameworks addons.

################################################################################
# Documentation
################################################################################

# Doxygen-Related
docs/html/*
docs/*
!docs/Doxyfile

# Instructions and other documentation files.
!docs/*.md
!docs/*.txt

################################################################################
# Examples
################################################################################

# bin/data Folder
example**/bin/*
example**/bin/data/*
!example**/bin/data
!example**/bin/data/data.txt


# Project files
example**/*.xcodeproj
example**/*.xcconfig
example**/config.make
example**/Makefile
example**/*.plist
!example**/addons.make


################################################################################
# Libraries
################################################################################

# Exclude 3rd party libs by default.
libs/*

# Don't exclude ofx libs by default.
!libs/ofx*

################################################################################
# Shared Data
################################################################################

shared/data/*
!shared/data/*.sh

################################################################################
# Scripts
################################################################################

# Everything included by default.

################################################################################
# Build Artifacts
################################################################################

# Default Qt Creator Build Folders
build-example*/

# Xcodebuild build folders
build/

################################################################################
# Utility Stuff
################################################################################

# Local folders, use for temporary storage, etc.
__*/*

# Temporary files.
*.autosave

# OSX
.DS_Store
.AppleDouble

# openFrameworks: commit src/, bin/data/ and addons.make only.
# Regenerate IDE projects with projectGenerator.
*.xcodeproj/
*.xcworkspace/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.cbp
xcuserdata/
.vscode/
*/Makefile
*/config.make
*/Project.xcconfig
*/openFrameworks-Info.plist
*/of.entitlements
*/icon.rc

# Build output (bin/data is kept)
*/bin/*
!*/bin/data/
obj/
*.o
*.app/
*.exe
*.pdb
*.ilk
*.exp

# OS / editor
._*
Thumbs.db
Desktop.ini
*.swp
.idea/
